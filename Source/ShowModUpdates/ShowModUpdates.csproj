<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputPath>../../1.7/Assemblies</OutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>None</DebugType>
    <LangVersion>latest</LangVersion>
    <FileVersion>1.7.0</FileVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyVersion>1.7</AssemblyVersion>
    <Product>Show Mod Updates</Product>
    <Copyright>© Mlie 2026 - MIT License</Copyright>
    <Nullable>warnings</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref">
      <Version>1.7.4981-unstable</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony">
      <Version>3.0.0-rc.3</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Mlie_Rimworld_VersionFromManifest" Version="*" />
  </ItemGroup>
  <Target Name="KillRimWorld" BeforeTargets="Clean;Build">
    <Exec Command="tasklist /FI &quot;IMAGENAME eq RimWorld.exe&quot; | find /I &quot;RimWorld.exe&quot; &lt;;nul &amp;&amp; taskkill /F /IM RimWorld.exe" IgnoreExitCode="true" />
  </Target>
</Project>